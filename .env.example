# Abhiyantrix Smart Event Management Platform — Environment Configuration Checklist
# ----------------------------------------------------------------------------------
# Note: The platform operates as a self-contained Single Page Application (SPA)
# with a client-side relational storage engine (localStorage).
# If connecting to an external API or microservice backend, configure the parameters below.

# Application Environment
NODE_ENV=production

# Application Base URL
VITE_APP_URL=https://abhiyantrix.vercel.app

# Optional External API Base URL (Leave blank when using native embedded database engine)
VITE_API_BASE_URL=

# Security & Session Configuration
JWT_SECRET=your_production_jwt_secret_here
SESSION_TIMEOUT_HOURS=24
